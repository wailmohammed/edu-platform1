# Server Configuration
NODE_ENV=development

# Database (required for real data)
DATABASE_URL=mysql://user:password@localhost:3306/edu_platform

# OAuth (required for authentication)
OAUTH_SERVER_URL=https://auth.manus.ai
VITE_OAUTH_PORTAL_URL=https://auth.manus.ai
VITE_APP_ID=your_app_id_here

# JWT Secret (required for production)
JWT_SECRET=your_jwt_secret_here

# Owner/Admin Open ID (auto-admin access)
OWNER_OPEN_ID=A445-acfb2591d2a5

# Analytics (optional)
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=